# Copy to .env and use --env-file .env. Never commit .env.
TAVILY_API_KEY=
BIFROST_URL=http://localhost:8080/openai/v1
BIFROST_MODEL=
# Optional Bifrost virtual key, supplied as x-bf-vk.
BIFROST_VIRTUAL_KEY=
# Native plugin and verification service share this token. Required for live server.
FRESHNESSGUARD_TOKEN=
